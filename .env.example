# lexgraph configuration template.
#
# Copy this file to `.env` and fill in the provider keys. The application and the CLI read
# `.env` (variables already set in the environment win), and `docker compose` passes it to
# the containers. Every LEXGRAPH_* line is commented out and shows the built-in default (or
# an example, for settings that are unset by default): uncomment a line only to override it.

# --- Language model providers -------------------------------------------------------------
# Groq, primary provider of the main and fast models: https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio (Gemini fallback, Google embeddings): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenAI, only for `openai:` model specs (requires the `openai` extra).
# OPENAI_API_KEY=

# --- Tracing (optional) -------------------------------------------------------------------
# Send LangChain and LangGraph traces to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=lexgraph

# --- Model downloads (optional) -----------------------------------------------------------
# Hugging Face token: higher rate limits when the models are downloaded, locally or while
# docker compose builds the image.
# HF_TOKEN=

# --- Storage ------------------------------------------------------------------------------
# Root folder of the corpus (corpus/), the downloaded pages (raw/) and the golden set (eval/).
# LEXGRAPH_DATA_DIR=data
# Cache folder of the FastEmbed models (filled by scripts/download_models.py or on first use).
# LEXGRAPH_MODELS_DIR=data/models
# SQLite file that stores the conversation threads.
# LEXGRAPH_CHECKPOINT_PATH=data/checkpoints/threads.sqlite

# --- Vector store -------------------------------------------------------------------------
# Qdrant server URL; when unset, Qdrant runs embedded (one process at a time).
# LEXGRAPH_QDRANT_URL=http://localhost:6333
# API key of a secured Qdrant server.
# LEXGRAPH_QDRANT_API_KEY=
# Storage folder of embedded Qdrant.
# LEXGRAPH_QDRANT_PATH=data/qdrant
# Collection alias used for search.
# LEXGRAPH_COLLECTION=lexgraph

# --- Embeddings and reranking -------------------------------------------------------------
# The Docker image bakes in the models these settings select: rebuild it after changing them.
# Dense embeddings: "fastembed" (local ONNX model) or "google" (Gemini API, needs GOOGLE_API_KEY).
# LEXGRAPH_EMBEDDING_PROVIDER=fastembed
# Dense embedding model.
# LEXGRAPH_EMBEDDING_MODEL=google/embeddinggemma-300m
# Dense vector size; it must match the model (re-run ingest after changing it).
# LEXGRAPH_EMBEDDING_DIM=768
# Sparse model for keyword matching (BM25 with Portuguese stemming).
# LEXGRAPH_SPARSE_MODEL=Qdrant/bm25
# Cross-encoder used when reranking.
# LEXGRAPH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8

# --- Retrieval ----------------------------------------------------------------------------
# Search mode: "dense", "sparse" or "hybrid" (both, fused with reciprocal rank fusion).
# Hybrid is the default: with the agent's rewritten queries it has the best recall@10.
# LEXGRAPH_RETRIEVAL_MODE=hybrid
# Candidates fetched by each branch of a hybrid search.
# LEXGRAPH_PREFETCH_K=30
# Passages returned by a search.
# LEXGRAPH_TOP_K=10
# Passages sent to the language model as context.
# LEXGRAPH_CONTEXT_K=5
# Reciprocal rank fusion constant; when unset, Qdrant's default is used.
# LEXGRAPH_RRF_K=60
# Rerank search results with the cross-encoder by default (slow on CPU).
# LEXGRAPH_RERANK=false
# Candidates scored by the cross-encoder when reranking; more than LEXGRAPH_TOP_K, so that it
# can bring up passages from below the top k instead of only reordering them.
# LEXGRAPH_RERANK_CANDIDATES=20
# Longest chunk, in characters; longer articles are split (re-run ingest after changing it).
# LEXGRAPH_CHUNK_MAX_CHARS=1500
# Longest slice of a split article: long lists of incisos become chunks of a few incisos each.
# LEXGRAPH_CHUNK_PACK_CHARS=700

# --- Language models (specs are "provider:model", e.g. groq:, google_genai:, openai:) -----
# Main model, which writes the answers.
# LEXGRAPH_LLM_MODEL=groq:openai/gpt-oss-120b
# Model used when the main model fails.
# LEXGRAPH_LLM_FALLBACK_MODEL=google_genai:gemini-3.5-flash-lite
# Fast model for question analysis, passage grading, query rewriting and answer checking.
# LEXGRAPH_FAST_LLM_MODEL=groq:openai/gpt-oss-20b
# Model used when the fast model fails.
# LEXGRAPH_FAST_LLM_FALLBACK_MODEL=google_genai:gemini-3.5-flash-lite
# Timeout of each model call, in seconds.
# LEXGRAPH_LLM_TIMEOUT=60.0
# Maximum output tokens of each model call.
# LEXGRAPH_LLM_MAX_TOKENS=1024
# Reasoning effort of the gpt-oss models: "low", "medium" or "high".
# LEXGRAPH_LLM_REASONING_EFFORT=low

# --- Agent --------------------------------------------------------------------------------
# Query rewrites allowed when no retrieved passage is relevant.
# LEXGRAPH_MAX_REWRITES=1
# Answer regenerations allowed when the self-check finds unsupported claims.
# LEXGRAPH_MAX_REGENERATIONS=1
# Grade the retrieved passages for relevance before answering.
# LEXGRAPH_GRADING=true
# Check the answer against its sources after generating it.
# LEXGRAPH_VERIFICATION=true
# Previous conversation turns sent with each question.
# LEXGRAPH_HISTORY_TURNS=4

# --- API and UI ---------------------------------------------------------------------------
# Base URL of the API, used by the UI.
# LEXGRAPH_API_URL=http://127.0.0.1:8000
# When set, the /v1 endpoints require this value in the X-API-Key header (the UI sends it).
# LEXGRAPH_API_KEY=
# Browser origins allowed to call the API (JSON list).
# LEXGRAPH_CORS_ORIGINS='["http://localhost:8501","http://127.0.0.1:8501"]'
# Host headers the API accepts, a guard against DNS rebinding (JSON list; ["*"] accepts any).
# Add the host name or address clients use when the API is reached from another machine.
# LEXGRAPH_ALLOWED_HOSTS='["localhost","127.0.0.1","[::1]","api"]'
# Longest question accepted, in characters (at most 8000).
# LEXGRAPH_MAX_QUESTION_CHARS=2000
# Log level: DEBUG, INFO, WARNING or ERROR.
# LEXGRAPH_LOG_LEVEL=INFO

# --- Evaluation ---------------------------------------------------------------------------
# Judge model of `lexgraph eval judge` (same as --judge-model). By default the judge is
# google_genai:gemini-3.8-flash, else the fast model or its fallback; never an answer model.
# LEXGRAPH_JUDGE_MODEL=google_genai:gemini-3.8-flash

# --- Docker Compose (variable substitution in compose.yaml) -------------------------------
# Arguments of the one-shot indexing service, e.g. index a single law for a quick start.
# The service keeps an index that already holds the same chunks and models.
# INGEST_ARGS="--law LGPD"
# Bake the cross-encoder reranker into the image (about 0.6 GB more); without it, reranking
# is reported as unavailable. Defaults to LEXGRAPH_RERANK.
# INCLUDE_RERANKER=false
